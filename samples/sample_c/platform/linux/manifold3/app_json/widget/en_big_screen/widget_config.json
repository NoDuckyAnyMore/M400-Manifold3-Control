{
    "version": { "major": 1, "minor": 0 },
    "main_interface": {
        "floating_window": { "is_enable": true },
        "speaker": { "is_enable_tts": false, "is_enable_voice": false },
        "widget_list": [
            {
                "widget_index": 0, "widget_type": "button", "widget_name": "START RECORDING",
                "icon_file_set": { "icon_file_name_selected": "icon_record_selected.png", "icon_file_name_unselected": "icon_record.png" },
                "customize_rc_buttons_config": { "is_enable": false, "mapping_config_display_order": 0 }
            },
            {
                "widget_index": 1, "widget_type": "button", "widget_name": "STOP RECORDING",
                "icon_file_set": { "icon_file_name_selected": "icon_stop_selected.png", "icon_file_name_unselected": "icon_stop.png" },
                "customize_rc_buttons_config": { "is_enable": false, "mapping_config_display_order": 1 }
            },
            {
                "widget_index": 7, "widget_type": "button", "widget_name": "EMERGENCY HOVER",
                "icon_file_set": { "icon_file_name_selected": "icon_emergency_selected.png", "icon_file_name_unselected": "icon_emergency_red.png" },
                "customize_rc_buttons_config": { "is_enable": false, "mapping_config_display_order": 2 }
            }
        ]
    },
    "config_interface": {
        "text_input_box": { "widget_name": "Unused", "placeholder_text": "", "is_enable": false },
        "widget_list": [
            {
                "widget_index": 2, "widget_type": "switch", "widget_name": "Flight data recording",
                "customize_rc_buttons_config": { "is_enable": false, "mapping_config_display_order": 0 }
            },
            {
                "widget_index": 3, "widget_type": "list", "widget_name": "RTK status (read only)",
                "list_item": [
                    { "item_name": "Disconnected" }, { "item_name": "Connected / no fix" }, { "item_name": "Single" },
                    { "item_name": "Float" }, { "item_name": "Fixed" }, { "item_name": "Other" }
                ],
                "customize_rc_buttons_config": { "is_enable": false, "mapping_config_display_order": 1 }
            },
            { "widget_index": 4, "widget_type": "int_input_box", "widget_name": "Longitude x10^7 (read only)", "int_input_box_hint": "unit: deg x 1e7" },
            { "widget_index": 5, "widget_type": "int_input_box", "widget_name": "Latitude x10^7 (read only)", "int_input_box_hint": "unit: deg x 1e7" },
            {
                "widget_index": 6, "widget_type": "list", "widget_name": "Last command state (read only)",
                "list_item": [
                    { "item_name": "Idle" }, { "item_name": "Queued" }, { "item_name": "Running" },
                    { "item_name": "Success" }, { "item_name": "Rejected" }, { "item_name": "Failed" },
                    { "item_name": "Emergency hover" }
                ],
                "customize_rc_buttons_config": { "is_enable": false, "mapping_config_display_order": 2 }
            },
            { "widget_index": 8, "widget_type": "int_input_box", "widget_name": "Waypoint forward/back (m)", "int_input_box_hint": "-10 to 10; positive forward" },
            { "widget_index": 9, "widget_type": "int_input_box", "widget_name": "Waypoint left/right (m)", "int_input_box_hint": "-10 to 10; positive left" },
            { "widget_index": 10, "widget_type": "int_input_box", "widget_name": "Waypoint up/down (m)", "int_input_box_hint": "-10 to 10; positive up" },
            { "widget_index": 11, "widget_type": "int_input_box", "widget_name": "Waypoint speed (m/s)", "int_input_box_hint": "1 to 10; default 2" },
            { "widget_index": 12, "widget_type": "int_input_box", "widget_name": "Safe takeoff height (m)", "int_input_box_hint": "Ignored in air; default 40" },
            { "widget_index": 13, "widget_type": "int_input_box", "widget_name": "Final yaw (deg)", "int_input_box_hint": "-180 to 180; absolute from north" },
            { "widget_index": 14, "widget_type": "button", "widget_name": "Execute straight two-point route", "customize_rc_buttons_config": { "is_enable": false, "mapping_config_display_order": 3 } },
            { "widget_index": 15, "widget_type": "button", "widget_name": "Fixed waypoint 2 m/s, H20 m", "customize_rc_buttons_config": { "is_enable": false, "mapping_config_display_order": 4 } },
            { "widget_index": 16, "widget_type": "button", "widget_name": "Fixed waypoint 10 m/s, H20 m", "customize_rc_buttons_config": { "is_enable": false, "mapping_config_display_order": 5 } },
            {
                "widget_index": 17, "widget_type": "list", "widget_name": "Browse CSV files",
                "list_item": [
                    { "item_name": "Newest" }, { "item_name": "Previous" }, { "item_name": "Third newest" },
                    { "item_name": "Fourth newest" }, { "item_name": "Fifth newest" }
                ],
                "customize_rc_buttons_config": { "is_enable": false, "mapping_config_display_order": 6 }
            },
            { "widget_index": 18, "widget_type": "int_input_box", "widget_name": "Selected CSV date (read only)", "int_input_box_hint": "YYYYMMDD" },
            { "widget_index": 19, "widget_type": "int_input_box", "widget_name": "Selected CSV time (read only)", "int_input_box_hint": "HHMMSS; full name in floating window" }
        ]
    }
}
